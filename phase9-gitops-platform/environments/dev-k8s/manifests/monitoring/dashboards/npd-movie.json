   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Đang xem ≈",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(rate(cinehome_playback_watch_seconds_total[2m])) or vector(0)",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "description": "Giây phát / giây thực = số luồng đang phát đồng thời."
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Startup p95",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(cinehome_playback_startup_seconds_bucket[15m])))",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 2
       },
       {
        "color": "red",
        "value": 3
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
